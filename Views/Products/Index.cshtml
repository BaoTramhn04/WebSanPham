@model List<WebProductManagement.Models.Product>

@{
    ViewData["Title"] = "Danh sách sản phẩm";
    var search = ViewBag.Search as string ?? "";
    var page = (int?)ViewBag.Page ?? 1;
    var totalPages = (int?)ViewBag.TotalPages ?? 1;
}

<h2 class="text-center mb-4">@ViewData["Title"]</h2>

<!-- Form tìm kiếm -->
<form asp-action="Index" method="get" class="mb-3">
    <div class="input-group">
        <input type="text" name="search" value="@search" class="form-control" placeholder="Nhập tên sản phẩm...">
        <button type="submit" class="btn btn-primary">Tìm kiếm</button>
    </div>
</form>

<!-- Nút thêm mới -->
<a class="btn btn-success mb-3" href="@Url.Action("Create")">+ Thêm mới</a>

<!-- Bảng hiển thị -->
<table class="table table-bordered table-striped">
    <thead class="table-dark">
        <tr>
            <th>ID</th>
            <th>Tên sản phẩm</th>
            <th>Giá</th>
            <th>Tồn kho</th>
            <th>Mô tả</th>
            <th></th>
        </tr>
    </thead>
    <tbody>
        @if (Model != null && Model.Any())
        {
            foreach (var p in Model)
            {
                <tr>
                    <td>@p.Id</td>
                    <td>@p.Name</td>
                    <td>@String.Format("{0:N0}", p.Price)</td>
                    <td>@p.Stock</td>
                    <td>@p.Description</td>
                    <td>
                        <a class="btn btn-warning btn-sm" href="@Url.Action("Edit", new { id = p.Id })">Sửa</a>
                        <a class="btn btn-info btn-sm" href="@Url.Action("Details", new { id = p.Id })">Xem</a>
                        <a class="btn btn-danger btn-sm" href="@Url.Action("Delete", new { id = p.Id })">Xóa</a>
                    </td>
                </tr>
            }
        }
        else
        {
            <tr>
                <td colspan="6" class="text-center">Không có sản phẩm nào.</td>
            </tr>
        }
    </tbody>
</table>

<!-- Phân trang -->
@if (totalPages > 1)
{
    <nav>
        <ul class="pagination justify-content-center">
            @for (int i = 1; i <= totalPages; i++)
            {
                <li class="page-item @(i == page ? "active" : "")">
                    <a class="page-link" href="@Url.Action("Index", new { search = search, page = i })">@i</a>
                </li>
            }
        </ul>
    </nav>
}
